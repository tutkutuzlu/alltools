{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://all-tools.local/schemas/tool.schema.json",
  "title": "Tool Plugin Manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "type", "family", "slug", "status", "entry", "category", "tags", "aliases", "components", "capabilities"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string" },
    "type": { "enum": ["tool", "calculator", "converter", "generator", "formatter", "visualizer", "game", "reference"] },
    "family": { "type": "string" },
    "variant": { "type": "string" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "status": { "enum": ["draft", "published", "deprecated"] },
    "entry": { "type": "string", "pattern": "^\\./" },
    "category": { "type": "string" },
    "tags": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "aliases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "components": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "capabilities": {
      "type": "object",
      "required": ["offline", "fileAccess", "networkAccess", "webWorker"],
      "properties": {
        "offline": { "type": "boolean" },
        "fileAccess": { "type": "boolean" },
        "networkAccess": { "type": "boolean" },
        "webWorker": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
